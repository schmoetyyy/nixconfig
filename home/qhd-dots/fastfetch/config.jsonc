// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/nixconfig/home/qhd-dots/asciiart/banksy.txt",
    "type": "auto",
    "width": 12,
    "padding": {
      "top": 1,
      "right": 4,
      "left": 3,
    },
    "color": {
      "1": "red",
      "2": "red",
      "3": "red",
      "4": "red",
      "5": "red",
      "6": "red",
      "7": "red",
      "8": "red",
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "red",
      "title": "red",
    },
  },
   "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#red} user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#red}󰇅 hname   {#keys}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "type": "command",
      "key": "│ {#red}󱦟 os age  {#keys}│",
      "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\"",
    },
    {
      "key": "│ {#red}󰅐 uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#red}{icon} distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#red} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#red} wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#red}󰇄 desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#red} term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#red} shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#red}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#red}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#red} memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#red} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
